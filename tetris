#!/usr/bin/env bash
# Launch Tetris.
#
# Works from anywhere: a terminal (./tetris), a file manager double-click, or
# a .desktop entry. Uses the project virtualenv when it exists, otherwise the
# system Python, and fails with an actionable message if pygame is missing.
set -euo pipefail

# Resolve the real file location so symlinked launchers still find the game.
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
cd "$SCRIPT_DIR"

# Prefer the project-local interpreter so pinned dependencies are honoured.
if [[ -x "$SCRIPT_DIR/.venv/bin/python" ]]; then
    PYTHON="$SCRIPT_DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="$(command -v python3)"
else
    printf 'error: python3 was not found.\nInstall it with: sudo pacman -S python\n' >&2
    exit 1
fi

if ! "$PYTHON" -c 'import pygame' >/dev/null 2>&1; then
    printf 'error: pygame is not available for %s\n\n' "$PYTHON" >&2
    printf 'Install it with one of:\n' >&2
    printf '  sudo pacman -S python-pygame\n' >&2
    printf '  %s -m pip install -r requirements.txt\n' "$PYTHON" >&2
    exit 1
fi

# exec replaces this shell, so window-manager signals reach Python directly.
exec "$PYTHON" "$SCRIPT_DIR/tetris.py" "$@"
